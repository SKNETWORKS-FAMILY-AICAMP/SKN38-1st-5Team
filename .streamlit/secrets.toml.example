# 이 파일 복사해서 secrets.toml 만들고 값 채우면 됩니다
# secrets.toml은 깃허브에 올리면 안 돼요!!

[mysql]
host = "localhost"
port = 3306
user = "root"
password = ""
database = "chachacha"
# 로컬에서는 ssl_ca 줄을 아예 넣지 마세요 (빈 값이어도 TLS가 켜져서 접속이 안 될 수 있어요)

# 클라우드 DB로 접속할 때는 위 [mysql]을 지우고 아래 주석을 풀어서 쓰세요
# [mysql]이 두 번 있으면 에러 납니다
#
# [mysql]
# host = "DB 주소"
# port = 3306
# user = "아이디"
# password = "비밀번호"
# database = "chachacha"
#
# ssl_ca는 아래 둘 중 하나만 쓰세요
# 내 컴퓨터에서 돌릴 때
# ssl_ca = "~/Downloads/ca.pem"
# Streamlit Cloud에 올릴 때 (파일을 못 둬서 인증서 내용을 그대로 붙여넣어요)
# ssl_ca = """-----BEGIN CERTIFICATE-----
# 인증서 내용
# -----END CERTIFICATE-----"""

[kakao]
javascript_api_key = ""  # 지도
rest_api_key = ""  # 도보 경로
