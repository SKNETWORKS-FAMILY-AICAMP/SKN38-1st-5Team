# 실제 접속 정보는 버전 관리에서 제외한 secrets.toml에 입력한다.
[mysql]
host = "localhost"
port = 3306
user = "root"
password = ""
database = "chachacha"
# 로컬 MySQL에서는 ssl_ca를 추가하지 않는다. 빈 값도 명시하면 TLS가 활성화된다.
# 원격 MySQL은 항상 TLS와 서버 인증서를 검증한다. 사설 CA가 필요할 때만 아래를 설정한다.
# 값은 인증서 파일 경로이거나, 파일을 둘 수 없는 배포 환경이면 PEM 내용 자체(여러 줄 문자열)다.
# ssl_ca = "/path/to/ca.pem"

# API 키는 secrets.toml 또는 ANTHROPIC_API_KEY 환경변수로 설정한다.
[anthropic]
api_key = ""

[kakao]
javascript_api_key = ""
rest_api_key = ""
